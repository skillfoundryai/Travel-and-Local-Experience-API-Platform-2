{
  "name": "environment-config-service",
  "version": "1.0.0",
  "description": "Node.js TypeScript service with validated environment configuration",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
